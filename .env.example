# ---------------------------------------------------------------------------
# FinRAG environment template
#
# IMPORTANT: Provider API keys (OpenAI, Anthropic, Google, etc.) are NEVER set
# here. They are supplied by the end user from the browser at runtime via the
# X-Provider-Key header and live only on request.state. This file is for
# infrastructure config only.
# ---------------------------------------------------------------------------

# ---------- Backend ----------
FINRAG_ENV=dev                       # dev | prod
FINRAG_HOST=0.0.0.0
FINRAG_PORT=8000
FINRAG_LOG_LEVEL=info
FINRAG_CORS_ORIGINS=http://localhost:3000

# ---------- Database (sessions/messages/documents metadata) ----------
# Default is local SQLite under ./data/finrag.db
# For Postgres: postgresql+asyncpg://user:pass@host:5432/finrag
FINRAG_DATABASE_URL=sqlite+aiosqlite:///./data/finrag.db

# ---------- Qdrant (vector DB) ----------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# Set to "memory" to skip Docker and run Qdrant in-process (no persistence).
QDRANT_MODE=server

# ---------- Redis (arq job queue) ----------
REDIS_URL=redis://redis:6379/0

# ---------- MinIO (S3-compatible file storage) ----------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=finrag
S3_REGION=us-east-1
S3_USE_SSL=false

# ---------- Embeddings / reranker ----------
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
SPARSE_MODEL=prithivida/Splade_PP_en_v1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE=http://localhost:8000
